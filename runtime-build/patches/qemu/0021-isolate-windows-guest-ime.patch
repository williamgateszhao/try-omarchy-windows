+#ifdef _WIN32
+static void sdl2_win32_disable_ime(struct sdl2_console *scon)
+{
+    SDL_SysWMinfo info = { 0 };
+
+    if (!scon->real_window || !qemu_console_is_graphic(scon->dcl.con)) {
+        return;
+    }
+
+    SDL_VERSION(&info.version);
+    if (SDL_GetWindowWMInfo(scon->real_window, &info)) {
+        /* SDL_StopTextInput alone may leave a newly created window's default
+         * input context associated, especially on secondary displays.
+         * The guest composes its own text from physical key events.
+         */
+        ImmAssociateContext(info.info.win.window, NULL);
+    }
+}
+
+static int sdl2_win32_text_input(void *opaque, SDL_Event *event)
+{
+    struct sdl2_console *scon;
+
+    if (event->type != SDL_WINDOWEVENT ||
+        event->window.event != SDL_WINDOWEVENT_FOCUS_GAINED) {
+        return 1;
+    }
+    scon = get_scon_from_window(event->window.windowID);
+    if (!scon || scon->real_window != SDL_GetKeyboardFocus()) {
+        return 1;
+    }
+
+    /* SDL sends FOCUS_GAINED before starting native text input for the new
+     * focus window. Act synchronously here: handling the queued event later
+     * can lose the first key to the Windows IME. QEMU's own text consoles
+     * still need SDL_TEXTINPUT; guest terminals use the virtual keyboard.
+     */
+    if (qemu_console_is_graphic(scon->dcl.con)) {
+        if (SDL_IsTextInputActive()) {
+            SDL_StopTextInput();
+        }
+    } else {
+        SDL_StartTextInput();
+    }
+    return 1;
+}
+#endif
